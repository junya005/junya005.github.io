---
const today = new Date();
const socialLinks = [
  { name: "GitHub", url: "https://github.com/junya005" },
];
---

<footer class="footer">
  <div class="footer-container">
    <div class="cloud-divider"></div>
    <div class="footer-content">
      <div class="footer-brand">
        <span class="brand-name">Junya Kobayashi</span>
        <span class="brand-role">Game Programmer Portfolio</span>
      </div>
      <nav class="social-links" aria-label="ソーシャルリンク">
        {
          socialLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="social-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span>{link.name}</span>
            </a>
          ))
        }
      </nav>
      <p class="copyright">&copy; {today.getFullYear()} Junya Kobayashi. Built with Astro.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface-cloud) 100%);
    color: var(--color-text-muted);
    padding: 3rem 1rem 2rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-container {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .brand-role {
    font-size: 0.85rem;
    color: var(--color-primary);
    font-weight: 500;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-body);
    font-size: 0.88rem;
    font-weight: 500;
    box-shadow: var(--shadow-cloud-sm);
    transition: all 0.2s ease;
  }

  .social-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-cloud-md);
  }

  .copyright {
    font-size: 0.82rem;
    color: var(--color-text-light);
    margin: 0;
  }
</style>
