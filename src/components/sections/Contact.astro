---

<section id="contact" class="section contact-section">
  <div class="container">
    <div class="contact-card">
      <span class="section-sub">GET IN TOUCH</span>
      <h2 class="contact-title">お問い合わせ / リンク</h2>
      <p class="contact-desc">
        作品のソースコードや詳細、インターンシップ等のご連絡は以下よりお気軽にお願いいたします。
      </p>

      <div class="contact-links">
        <a
          href="https://github.com/junya005"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline contact-btn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          <span>GitHub (@junya005)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .container {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section-sub {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .contact-section {
    background: #ffffff;
  }

  .contact-card {
    background: linear-gradient(135deg, #eaf7fd 0%, #fff1f5 100%);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(72, 184, 236, 0.2);
    padding: 3.5rem 2rem;
    text-align: center;
    box-shadow: var(--shadow-cloud-md);
  }

  .contact-title {
    font-size: 1.85rem;
    margin-bottom: 0.75rem;
  }

  .contact-desc {
    max-width: 550px;
    margin: 0 auto 2rem;
    color: var(--color-text-body);
  }

  .contact-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .contact-btn {
    background: #ffffff !important;
    padding: 0.75rem 1.75rem;
  }
</style>
