---
import { getBaseUrl } from "../../utils/url";

const baseUrl = getBaseUrl();
---

<section id="about" class="section about-section">
  <div class="container">
    <div class="section-header">
      <span class="section-sub">ABOUT ME</span>
      <h2 class="section-title">私について</h2>
    </div>

    <div class="about-card">
      <div class="about-profile-side">
        <div class="avatar-wrap">
          <img
            src={`${baseUrl}images/icons/avater.jpg`}
            alt="小林 純也"
            class="avatar-img"
          />
        </div>
        <h3 class="profile-name">小林 純也</h3>
        <p class="profile-role">Junya Kobayashi</p>
        <span class="profile-status-badge">就活・インターン活動中</span>
      </div>

      <div class="about-detail-side">
        <div class="about-info-grid">
          <div class="info-cell">
            <span class="info-label">希望職種</span>
            <span class="info-val">ゲームプログラマー / クライアントエンジニア</span>
          </div>
          <div class="info-cell">
            <span class="info-label">専攻</span>
            <span class="info-val">
              東京デザインテクノロジーセンター専門学校<br />
              スーパーIT科 スーパーゲームクリエイター専攻
            </span>
          </div>
          <div class="info-cell">
            <span class="info-label">志向性</span>
            <span class="info-val">アルゴリズム実装・ゲームプレイ挙動の追求</span>
          </div>
        </div>

        <div class="about-text">
          <h4>ゲームづくりへの思いとこだわり</h4>
          <p>
            現在、専門学校でゲーム開発を学んでいます。単にアセットを配置するだけでなく、
            <strong>「なぜその挙動になるのか」「どうすればプレイヤーが手触りの良さを感じられるか」</strong>
            を数学や物理のロジックに基づいてコードに落とし込むことに面白さを感じています。
          </p>
          <p>
            ピンボールゲームでのフリッパー角度と初速の微調整や、放物線計算によるキャッチボールの軌道予測、ダンジョンの自動生成など、
            自らの手で仕組みを一から組み上げる開発を得意としています。
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .container {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 3rem;
  }

  .section-sub {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: 2.1rem;
    margin-bottom: 0.75rem;
  }

  .about-section {
    background-color: var(--color-surface-cloud);
  }

  .about-card {
    background: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-cloud-md);
    display: grid;
    grid-template-columns: 280px 1fr;
    overflow: hidden;
  }

  .about-profile-side {
    background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 100%);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-right: 1px solid var(--color-border-light);
  }

  .avatar-wrap {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    padding: 4px;
    background: #ffffff;
    box-shadow: var(--shadow-cloud-md);
    margin-bottom: 1.25rem;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-name {
    font-size: 1.4rem;
    margin: 0 0 0.25rem;
  }

  .profile-role {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .profile-status-badge {
    background-color: var(--color-accent-soft);
    color: #e05d84;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 153, 182, 0.4);
  }

  .about-detail-side {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .about-info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .info-cell {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .info-label {
    font-size: 0.75rem;
    color: var(--color-text-light);
    font-weight: 600;
    text-transform: uppercase;
  }

  .info-val {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .about-text h4 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
  }

  .about-text p {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-text-body);
    margin-bottom: 1rem;
  }

  .about-text p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 960px) {
    .about-card {
      grid-template-columns: 1fr;
    }

    .about-profile-side {
      border-right: none;
      border-bottom: 1px solid var(--color-border-light);
      padding: 2rem;
    }

    .about-info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
