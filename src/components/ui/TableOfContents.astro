---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  maxDepth?: number;
}

const { headings, maxDepth = 3 } = Astro.props;

// depth 2 (h2) と depth 3 (h3) の見出しのみ抽出
const tocItems = headings.filter(
  (h) => h.depth >= 2 && h.depth <= maxDepth
);
---

{tocItems.length >= 2 && (
  <nav class="toc-space" aria-label="記事の目次">
    <div class="toc-header">
      <div class="toc-title-group">
        <svg
          class="toc-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span class="toc-heading">目次</span>
      </div>
      <span class="toc-badge">INDEX</span>
    </div>

    <ul class="toc-list">
      {tocItems.map((item) => (
        <li class={`toc-item depth-${item.depth}`}>
          <a href={`#${item.slug}`} class="toc-link">
            {item.depth === 3 && <span class="toc-bullet" aria-hidden="true">•</span>}
            <span class="toc-text">{item.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc-space {
    background-color: var(--color-surface-cloud);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .toc-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toc-icon {
    color: var(--color-primary);
  }

  .toc-heading {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: 0.02em;
  }

  .toc-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-text-light);
    letter-spacing: 0.1em;
    background: #fff;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-light);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .toc-item {
    line-height: 1.5;
  }

  .toc-item.depth-2 {
    font-weight: 600;
    margin-top: 0.35rem;
  }

  .toc-item.depth-2:first-child {
    margin-top: 0;
  }

  .toc-item.depth-3 {
    padding-left: 1.25rem;
    font-size: 0.92rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .toc-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--color-text-body);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .toc-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
    transform: translateX(2px);
  }

  .toc-item.depth-3 .toc-link {
    color: var(--color-text-muted);
  }

  .toc-item.depth-3 .toc-link:hover {
    color: var(--color-primary);
  }

  .toc-bullet {
    color: var(--color-primary);
    font-size: 0.8rem;
    user-select: none;
  }

  @media (max-width: 680px) {
    .toc-space {
      padding: 1.25rem 1rem;
    }

    .toc-item.depth-3 {
      padding-left: 0.85rem;
    }
  }
</style>
