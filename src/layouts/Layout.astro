---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!-- HTML -->
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Junya005's Portfolio</title>
  </head>
  <body>
    <div class="site-container">
      <Header />

      <!-- ここに各ページの内容 -->
      <main class="main-content">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>

<!-- CSS -->
<style>
  /* 表示全体の設定 */
  /* 画面全体をFlexboxにする */
  .site-container {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  /* メインコンテンツの設定 */
  /* メインコンテンツに余白を持たせる */
  .main-content {
    flex: 1;
  }
</style>
